# --- Dependencies -----------------------------------------------------------
# Restored by `pnpm install` from pnpm-lock.yaml, which IS tracked.
node_modules/

# --- Build output -----------------------------------------------------------
# The CLI runs TypeScript directly; the builds are the desktop shell's bundled core (ADR 0005) and
# the CLI bundle the artifact ships, both regenerated by `pnpm app:build`.
dist/
app/core.bundle.mjs
app/src/cli/index.mjs
*.tsbuildinfo
coverage/

# --- Regenerable output -----------------------------------------------------
# Everything below is reproducible from data/events.jsonl and the source tree.
# If it can be regenerated in one command, it does not belong in history.
#
#   bench chart -> artifacts/*.svg      bench state -> STATE.md
#
# Fixture screenshots used for visual review live here too: binary and disposable.
artifacts/

# Review frames from the real window, regenerated by `pnpm app:capture`. Binary and disposable, but
# the HTML contact sheet next to them is small, hand-written, and tracked.
docs/ui-review/*.png

# Derived projection of the log. Disposable by design.
index.sqlite
index.sqlite-journal
index.sqlite-wal

# --- Python analysis environment --------------------------------------------
# Recreated from recipes/requirements.lock.txt by `pnpm setup:recipes`.
recipes/.venv/
__pycache__/
*.py[cod]

# --- Machine-local tooling state --------------------------------------------
# Specific to this checkout, not to the project.
.freebuff/
.vscode/
.idea/

# --- Logs and OS cruft ------------------------------------------------------
*.log
.DS_Store
Thumbs.db
