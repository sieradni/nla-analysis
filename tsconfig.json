{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Turned on because a trial run found three pieces of real cruft: an unused import, an unused
    // parameter, and a shape check that should have been using its loop variable. Unused code is
    // where the next bug hides.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  // `app` is the desktop shell's TypeScript entry: it is bundled by esbuild, but if it is not
  // typechecked here the seam between the window and the core can rot silently.
  "include": ["src", "tests", "app"]
}
